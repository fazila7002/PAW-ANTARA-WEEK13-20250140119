<%
// 🛡️ DRY: komponen badge generic (label + warna), dipake di kartu produk
// & tabel produk admin. Nambah warna baru cukup di colorMap ini.
const colorMap = {
  green: 'bg-green-100 text-green-700 border-green-300',
  red: 'bg-red-100 text-red-700 border-red-300',
  yellow: 'bg-yellow-100 text-yellow-800 border-yellow-300',
  blue: 'bg-blue-100 text-blue-700 border-blue-300',
  gray: 'bg-gray-100 text-gray-600 border-gray-300',
};
const classes = colorMap[color] || colorMap.green;
%>
<span class="inline-block px-2 py-1 text-xs font-semibold rounded-full border whitespace-nowrap <%= classes %>">
  <%= label %>
</span>
