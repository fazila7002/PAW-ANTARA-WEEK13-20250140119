<%
// 🛡️ DRY: satu komponen badge status dipake di 4 halaman (invoice customer,
// detail invoice, daftar invoice admin, dashboard admin). Warna & labelnya
// diambil dari utils/orderStatus.js, jadi gak ada teks status yang di-hardcode.
const warna = {
  yellow: 'bg-yellow-100 text-yellow-800 border-yellow-200',
  blue:   'bg-blue-100 text-blue-800 border-blue-200',
  purple: 'bg-purple-100 text-purple-800 border-purple-200',
  green:  'bg-green-100 text-green-800 border-green-200',
  red:    'bg-red-100 text-red-800 border-red-200',
  gray:   'bg-gray-100 text-gray-700 border-gray-200',
};
const kelas = warna[getStatusColor(status)] || warna.gray;
%>
<span class="inline-block px-2.5 py-1 text-xs font-semibold rounded-full border <%= kelas %>">
  <%= getStatusLabel(status) %>
</span>
