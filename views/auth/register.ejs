<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head', { pageTitle: 'Daftar' }) %>
</head>
<body class="bg-gradient-to-br from-brand-50 via-white to-gray-50 min-h-screen grid place-items-center px-4">
  <main class="w-full max-w-sm">
    <div class="text-center mb-6">
      <div class="w-14 h-14 rounded-2xl bg-brand-600 text-white grid place-items-center text-2xl mx-auto mb-3">🛍️</div>
      <h1 class="text-2xl font-bold text-gray-800">Daftar Akun</h1>
      <p class="text-sm text-gray-500">Akun baru otomatis jadi customer</p>
    </div>

    <form method="POST" action="/register" class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm space-y-4">
      <% if (errors.length) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-3 py-2">
          <ul class="list-disc list-inside">
            <% errors.forEach(function (e) { %><li><%= e %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Nama Lengkap</label>
        <input name="name" value="<%= old.name %>" required
               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Username</label>
        <input name="username" value="<%= old.username %>" required
               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
        <input type="password" name="password" required
               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
      </div>

      <button class="w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-2.5 rounded-lg text-sm">
        Daftar
      </button>

      <p class="text-center text-sm text-gray-500">
        Udah punya akun? <a href="/login" class="text-brand-600 font-semibold">Masuk</a>
      </p>
    </form>
  </main>
</body>
</html>
