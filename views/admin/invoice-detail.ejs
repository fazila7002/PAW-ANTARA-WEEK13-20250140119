<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head', { pageTitle: 'Detail Invoice' }) %>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav', { active: 'invoice' }) %>

  <main class="max-w-2xl mx-auto px-4 py-6">
    <a href="/admin/invoice" class="text-sm text-brand-600 font-semibold">← Balik ke daftar invoice</a>

    <% if (notice) { %>
      <div class="bg-green-50 border border-green-200 text-green-800 rounded-xl px-4 py-3 my-4 text-sm"><%= notice %></div>
    <% } else { %>
      <div class="h-4"></div>
    <% } %>

    <!-- 🛡️ DRY: rincian invoice pakai partial yang SAMA dengan halaman customer -->
    <%- include('../partials/invoice-detail-body', { order }) %>

    <!-- KHUSUS ADMIN: ubah status pesanan -->
    <form method="POST" action="/admin/invoice/<%= order.id %>/status"
          class="bg-white border border-gray-200 rounded-2xl p-5 mt-4">
      <h3 class="font-semibold text-gray-700 mb-1">Ubah Status Pesanan</h3>
      <p class="text-xs text-gray-400 mb-3">
        Status sekarang: <strong><%= getStatusLabel(order.status) %></strong>.
        Kalau dibatalkan, stok produknya otomatis dikembalikan.
      </p>

      <div class="flex gap-2">
        <select name="status" class="flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm">
          <% statusList.forEach(function (s) { %>
            <option value="<%= s %>" <%= s === order.status ? 'selected' : '' %>><%= getStatusLabel(s) %></option>
          <% }) %>
        </select>
        <button class="bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-5 rounded-lg">Simpan</button>
      </div>
    </form>
  </main>
</body>
</html>
