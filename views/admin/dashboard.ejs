<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head', { pageTitle: 'Dashboard Admin' }) %>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav', { active: 'dashboard' }) %>

  <main class="max-w-6xl mx-auto px-4 py-6">
    <h2 class="font-bold text-gray-800 text-lg mb-1">Halo, <%= user.name %> 👋</h2>
    <p class="text-sm text-gray-500 mb-5">Ringkasan toko hari ini</p>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
      <%- include('../partials/stat-card', { label: 'Total Produk', value: produkStats.total, color: 'blue' }) %>
      <%- include('../partials/stat-card', { label: 'Stok Menipis', value: produkStats.menipis, color: 'yellow' }) %>
      <%- include('../partials/stat-card', { label: 'Pesanan Masuk', value: orderStats.totalOrder, color: 'purple' }) %>
      <%- include('../partials/stat-card', { label: 'Total Pendapatan', value: formatRupiah(orderStats.totalPendapatan), color: 'green' }) %>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      <div class="lg:col-span-2 bg-white border border-gray-200 rounded-2xl overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-200 flex items-center justify-between">
          <h3 class="font-semibold text-gray-700">Pesanan Terbaru</h3>
          <a href="/admin/invoice" class="text-xs text-brand-600 font-semibold">Lihat semua →</a>
        </div>

        <% if (orderTerbaru.length === 0) { %>
          <p class="text-center text-gray-400 py-8 text-sm">Belum ada pesanan masuk.</p>
        <% } else { %>
          <table class="w-full text-sm">
            <thead class="text-xs text-gray-400 bg-gray-50">
              <tr>
                <th class="text-left px-5 py-2">Invoice</th>
                <th class="text-left px-3 py-2">Pembeli</th>
                <th class="text-center px-3 py-2">Item</th>
                <th class="text-right px-3 py-2">Total</th>
                <th class="text-right px-5 py-2">Status</th>
              </tr>
            </thead>
            <tbody>
              <% orderTerbaru.forEach(function (o) { %>
                <tr class="border-t border-gray-100 hover:bg-gray-50">
                  <td class="px-5 py-2.5">
                    <a href="/admin/invoice/<%= o.id %>" class="font-semibold text-brand-600">INV-<%= String(o.id).padStart(5,'0') %></a>
                  </td>
                  <td class="px-3 py-2.5 text-gray-700"><%= o.buyerName %></td>
                  <td class="px-3 py-2.5 text-center text-gray-500"><%= o.items.length %> jenis</td>
                  <td class="px-3 py-2.5 text-right font-semibold text-gray-800"><%= formatRupiah(o.total) %></td>
                  <td class="px-5 py-2.5 text-right"><%- include('../partials/status-badge', { status: o.status }) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

      <div class="bg-white border border-gray-200 rounded-2xl p-5">
        <h3 class="font-semibold text-gray-700 mb-3">Aksi Cepat</h3>
        <div class="space-y-2">
          <a href="/admin/produk/baru" class="block bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold text-center py-2.5 rounded-lg">+ Tambah Produk</a>
          <a href="/admin/produk" class="block bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold text-center py-2.5 rounded-lg">Kelola Produk</a>
          <a href="/admin/invoice" class="block bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold text-center py-2.5 rounded-lg">Kelola Pesanan</a>
        </div>
        <div class="mt-4 pt-4 border-t border-gray-100 text-xs text-gray-500 space-y-1">
          <p>Pesanan menunggu: <strong class="text-gray-700"><%= orderStats.pending %></strong></p>
          <p>Pesanan selesai: <strong class="text-gray-700"><%= orderStats.selesai %></strong></p>
          <p>Produk habis: <strong class="text-gray-700"><%= produkStats.habis %></strong></p>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
